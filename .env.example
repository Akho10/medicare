# Copy to .env on the EC2 instance and replace both passwords with strong values.
MYSQL_DATABASE=medicare_db
MYSQL_USER=medicare
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# These are overridden by the Jenkins deployment stage.
DOCKERHUB_USERNAME=liliza
IMAGE_TAG=latest
FRONTEND_PORT=80
